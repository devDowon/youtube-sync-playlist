{
  "rules": {
    "queue": {
      ".read": true,
      ".write": true,
      "$songId": {
        ".validate": "newData.hasChildren(['videoId', 'title', 'addedAt']) && newData.child('videoId').isString() && newData.child('videoId').val().length == 11"
      }
    },
    "nowPlaying": {
      ".read": true,
      ".write": true
    },
    "chat": {
      ".read": true,
      ".write": true,
      "$messageId": {
        ".validate": "newData.hasChildren(['text', 'sentAt']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 300 && newData.child('sentAt').isNumber()"
      }
    },
    "presence": {
      ".read": true,
      "$clientId": {
        ".write": true,
        ".validate": "newData.isBoolean() && newData.val() == true"
      }
    },
    "skipVotes": {
      ".read": true,
      "$queueId": {
        "$clientId": {
          ".write": true,
          ".validate": "newData.isBoolean() && newData.val() == true"
        }
      }
    },
    "$other": {
      ".validate": false
    }
  }
}
